---
// No server logic needed here, just the loading screen.
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Loading Vixix Configs...</title>
    <style>
        /* Import Poppins - a clean, modern, rounded font */
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;700;800&display=swap');

        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #0a0f1a; /* Deep navy blue background */
            color: #ffffff;
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Container for the loading text */
        .loader-text {
            font-size: 3rem; /* Bigger, bolder text */
            font-weight: 800;
            letter-spacing: 0.05em;
            color: #ffffff;
            /* The blue neon glow */
            text-shadow: 
                0 0 10px rgba(59, 130, 246, 0.8),
                0 0 20px rgba(59, 130, 246, 0.6),
                0 0 40px rgba(59, 130, 246, 0.4);
            /* The jumping animation */
            animation: jump 1.2s ease-in-out infinite;
        }

        /* The 'typing' cursor */
        .cursor {
            display: inline-block;
            width: 4px;
            height: 1em;
            background-color: #3b82f6; /* Bright blue cursor */
            margin-left: 8px;
            box-shadow: 0 0 15px #3b82f6;
            animation: blink 1s step-end infinite;
        }

        /* Keyframe for the jumping/glow wave */
        @keyframes jump {
            0%, 100% {
                transform: translateY(0);
                text-shadow: 
                    0 0 10px rgba(59, 130, 246, 0.8),
                    0 0 20px rgba(59, 130, 246, 0.6),
                    0 0 40px rgba(59, 130, 246, 0.4);
            }
            50% {
                transform: translateY(-15px); /* Jump higher */
                text-shadow: 
                    0 0 20px rgba(59, 130, 246, 1),
                    0 0 40px rgba(59, 130, 246, 0.8),
                    0 0 60px rgba(59, 130, 246, 0.6);
            }
        }

        /* Keyframe for the blinking cursor */
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
    </style>
</head>
<body>
    
    <div class="loader-text" id="loaderText">
        <span id="textContent"></span><span class="cursor"></span>
    </div>

    <script>
        // The text to type out
        const textToType = "Vixix Configs";
        const textContent = document.getElementById('textContent');
        
        let charIndex = 0;

        function typeWriter() {
            if (charIndex < textToType.length) {
                // Add the next character
                textContent.textContent += textToType.charAt(charIndex);
                charIndex++;
                // Type the next character after 120 milliseconds
                setTimeout(typeWriter, 120);
            } else {
                // Once typing is done, wait a moment and then redirect
                setTimeout(() => {
                    window.location.href = '/configs';
                }, 1500); // 1.5 second pause after typing finishes
            }
        }

        // Start the typing effect when the page loads
        window.onload = typeWriter;
    </script>

</body>
</html>
