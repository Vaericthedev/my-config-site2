---
// No server logic needed here, just the loading screen.
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <!-- CRITICAL: Makes mobile scale properly -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Loading Vixix Configs...</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;700;800&display=swap');

        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #050810; 
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(59, 130, 246, 0.15), transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.1), transparent 50%);
            background-size: 200% 200%;
            animation: bg-pan 15s ease-in-out infinite alternate;
            color: #ffffff;
            margin: 0;
            min-height: 100dvh; 
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 20px; 
        }

        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
            mask-image: radial-gradient(circle at center, transparent 20%, black 80%);
            -webkit-mask-image: radial-gradient(circle at center, transparent 20%, black 80%);
        }

        /* Click to Enter Button - Fluid Size */
        #enterBtn {
            font-family: 'Poppins', sans-serif;
            font-size: clamp(1rem, 4vw, 1.5rem);
            font-weight: 600;
            color: #ffffff;
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.5);
            padding: clamp(12px, 3vw, 18px) clamp(24px, 6vw, 50px);
            border-radius: 50px;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(59, 130, 246, 0.2);
            animation: pulseBtn 2s infinite;
            white-space: nowrap;
        }

        #enterBtn:hover {
            background: rgba(59, 130, 246, 0.4);
            box-shadow: 0 0 30px rgba(59, 130, 246, 0.6);
            transform: scale(1.05);
        }

        @keyframes pulseBtn {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.03); }
        }

        /* Container for the loading text */
        .loader-container {
            display: none; 
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            text-align: center;
        }

        .loader-text {
            font-size: clamp(2rem, 8vw, 5rem); 
            font-weight: 800;
            letter-spacing: 0.05em;
            color: #ffffff;
            /* The jumping glow animation */
            animation: jumpGlow 1.2s ease-in-out infinite;
            line-height: 1.2;
            word-break: break-word;
        }

        .cursor {
            display: inline-block;
            width: 4px;
            height: 1em;
            background-color: #3b82f6; 
            margin-left: 8px;
            box-shadow: 0 0 15px #3b82f6;
            animation: blink 1s step-end infinite;
            vertical-align: middle;
        }

        #muteBtn {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: white;
            font-size: 1.5rem;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(5px);
        }

        #muteBtn:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        /* The core animation: jump + glow */
        @keyframes jumpGlow {
            0%, 100% {
                transform: translateY(0);
                text-shadow: 
                    0 0 10px rgba(59, 130, 246, 0.8),
                    0 0 20px rgba(59, 130, 246, 0.6),
                    0 0 40px rgba(59, 130, 246, 0.4);
            }
            50% {
                transform: translateY(-15px); 
                text-shadow: 
                    0 0 20px rgba(59, 130, 246, 1),
                    0 0 40px rgba(59, 130, 246, 0.8),
                    0 0 60px rgba(59, 130, 246, 0.6);
            }
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        @keyframes bg-pan {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }
    </style>
</head>
<body>
    
    <button id="enterBtn">Click to Enter</button>

    <div class="loader-container" id="loaderContainer">
        <div class="loader-text" id="loaderText">
            <span id="textContent"></span><span class="cursor"></span>
        </div>
    </div>

    <button id="muteBtn">🔇</button>

    <audio id="introMusic" src="/intro-music.mp3" loop></audio>

    <script>
        const enterBtn = document.getElementById('enterBtn');
        const loaderContainer = document.getElementById('loaderContainer');
        const textContent = document.getElementById('textContent');
        const music = document.getElementById('introMusic');
        const muteBtn = document.getElementById('muteBtn');
        
        let charIndex = 0;
        const textToType = "Vixix Configs";

        music.volume = 0.3; 

        enterBtn.addEventListener('click', () => {
            music.play().catch(error => console.log("Audio play failed:", error));
            enterBtn.style.display = 'none';
            loaderContainer.style.display = 'flex';
            muteBtn.textContent = '🔊'; 
            typeWriter();
        });

        muteBtn.addEventListener('click', () => {
            if (music.paused) {
                music.play();
                muteBtn.textContent = '🔊';
            } else {
                music.pause();
                muteBtn.textContent = '🔇';
            }
        });

        function typeWriter() {
            if (charIndex < textToType.length) {
                textContent.textContent += textToType.charAt(charIndex);
                charIndex++;
                setTimeout(typeWriter, 120);
            } else {
                setTimeout(() => {
                    let fadeOut = setInterval(() => {
                        if (music.volume > 0.05) {
                            music.volume -= 0.05;
                        } else {
                            clearInterval(fadeOut);
                            music.pause();
                        }
                    }, 100);

                    setTimeout(() => {
                        window.location.href = '/configs';
                    }, 1500);
                }, 1500); 
            }
        }
    </script>

</body>
</html>
