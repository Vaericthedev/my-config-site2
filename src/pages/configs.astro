---
// This runs on the server before the page loads
const GITHUB_USERNAME = "Vaericthedev";
const REPO_NAME = "my-config-site2";
const FOLDER_NAME = "Roblox"; 
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Vixix Configs</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

        /* 1. BACKGROUND */
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            color: #ffffff;
            min-height: 100vh;
            margin: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
        }

        /* 2. MAIN GLASS CONTAINER */
        .glass-container {
            width: 100%;
            max-width: 900px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        }

        h1 { 
            color: #ffffff; 
            font-weight: 800;
            text-shadow: 0 0 20px rgba(88, 101, 242, 0.6);
            margin-top: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        p.subtitle {
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 25px;
        }

        /* 3. SEARCH AND SORT CONTROLS */
        .controls { 
            display: flex; 
            gap: 15px; 
            margin-bottom: 30px; 
            flex-wrap: wrap;
        }
        
        input, select {
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.3);
            color: white;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: all 0.3s ease;
            flex: 1;
            min-width: 200px;
        }

        input:focus, select:focus {
            border-color: rgba(88, 101, 242, 0.8);
            background: rgba(0, 0, 0, 0.5);
            box-shadow: 0 0 15px rgba(88, 101, 242, 0.3);
        }

        /* 4. CONFIG GRID */
        .config-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        /* 5. FROSTED GLASS CARDS */
        .config-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            padding: 20px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            /* IMPORTANT: This stops items from stretching to full width */
            align-items: flex-start; 
            gap: 15px;
        }

        .config-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .config-card h3 { 
            margin: 0; 
            word-break: break-all; 
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: -0.02em;
        }

        /* ========================================= */
        /* 6. SMALL TRANSPARENT HORIZONTAL BUTTON    */
        /* ========================================= */
        .download-btn {
            /* Horizontal layout */
            display: inline-flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 6px !important; /* Space between icon and text */
            
            /* Small sizing (Doesn't fill the box) */
            width: auto !important; 
            height: auto !important;
            padding: 8px 14px !important;
            margin: 0 !important;

            /* Completely Transparent */
            background: transparent !important; 
            border: 1px solid rgba(255, 255, 255, 0.2) !important; /* Subtle outline */
            border-radius: 8px !important; /* Clean rounded corners */
            color: #ffffff !important;
            
            /* Small text */
            font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif !important;
            font-size: 13px !important;
            font-weight: 600 !important;
            text-decoration: none !important;
            
            /* Interaction */
            cursor: pointer !important;
            outline: none !important;
            transition: all 0.2s ease !important;
        }

        /* Hover: Subtle frosted glass glow */
        .download-btn:hover {
            background: rgba(255, 255, 255, 0.1) !important;
            border-color: rgba(255, 255, 255, 0.5) !important;
            transform: translateY(-1px) !important;
        }

        /* Click: Tactile press */
        .download-btn:active {
            transform: scale(0.97) translateY(0) !important;
            background: rgba(255, 255, 255, 0.05) !important;
        }

        /* Force the SVG to be tiny, white, and unbroken */
        .download-btn svg {
            width: 14px !important;
            height: 14px !important;
            min-width: 14px !important;
            max-width: 14px !important;
            min-height: 14px !important;
            max-height: 14px !important;
            flex-shrink: 0 !important;
            display: block !important;
            stroke: #ffffff !important;
            stroke-width: 2.5 !important;
            fill: none !important;
        }

        #loading { 
            font-style: italic; 
            color: rgba(255, 255, 255, 0.5); 
            text-align: center;
            padding: 20px;
        }
    </style>
</head>
<body>
    
    <div class="glass-container">
        <h1>🎮 Roblox Configs</h1>
        <p class="subtitle">Download the latest premium configs below.</p>

        <div class="controls">
            <input type="text" id="searchBar" placeholder="🔍 Search configs..." oninput="filterConfigs()" />
            <select id="sortSelect" onchange="sortConfigs()">
                <option value="name-asc">Sort by Name (A-Z)</option>
                <option value="name-desc">Sort by Name (Z-A)</option>
            </select>
        </div>

        <p id="loading">Loading configs from GitHub... ⏳</p>
        <div class="config-grid" id="configGrid"></div>
    </div>

    <script>
        const API_URL = `https://api.github.com/repos/Vaericthedev/my-config-site2/contents/Roblox`;
        let allConfigs = [];

        async function fetchConfigs() {
            try {
                const response = await fetch(API_URL);
                const data = await response.json();
                
                allConfigs = data.filter(file => {
                    const name = file.name.toLowerCase();
                    return name.endsWith('.json') || name.endsWith('.cfg') || name.endsWith('.txt');
                });

                document.getElementById('loading').style.display = 'none';
                renderConfigs(allConfigs);
            } catch (error) {
                document.getElementById('loading').innerText = "Error loading configs. Make sure the folder exists on GitHub!";
            }
        }

        function renderConfigs(configs) {
            const grid = document.getElementById('configGrid');
            grid.innerHTML = '';

            if (configs.length === 0) {
                grid.innerHTML = '<p style="color: rgba(255,255,255,0.5); grid-column: 1/-1;">No configs found.</p>';
                return;
            }

            configs.forEach(file => {
                const card = document.createElement('div');
                card.className = 'config-card';

                const title = document.createElement('h3');
                title.textContent = file.name;

                const btn = document.createElement('button');
                btn.className = 'download-btn';
                
                btn.innerHTML = `
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Download</span>
                `;
                
                btn.addEventListener('click', () => {
                    forceDownload(file.download_url + '?raw=true', file.name);
                });

                card.appendChild(title);
                card.appendChild(btn);
                grid.appendChild(card);
            });
        }

        async function forceDownload(url, filename) {
            try {
                const response = await fetch(url);
                const blob = await response.blob();
                const blobUrl = window.URL.createObjectURL(blob);
                
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = blobUrl;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                
                window.URL.revokeObjectURL(blobUrl);
                document.body.removeChild(a);
            } catch (error) {
                console.error('Download failed:', error);
                window.open(url, '_blank');
            }
        }

        function filterConfigs() {
            const query = document.getElementById('searchBar').value.toLowerCase();
            const filtered = allConfigs.filter(file => file.name.toLowerCase().includes(query));
            renderConfigs(filtered);
        }

        function sortConfigs() {
            const sortValue = document.getElementById('sortSelect').value;
            const sorted = [...allConfigs].sort((a, b) => {
                if (sortValue === 'name-asc') return a.name.localeCompare(b.name);
                if (sortValue === 'name-desc') return b.name.localeCompare(a.name);
                return 0;
            });
            renderConfigs(sorted);
        }

        fetchConfigs();
    </script>
</body>
</html>
