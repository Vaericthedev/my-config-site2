---
// This runs on the server before the page loads
const GITHUB_USERNAME = "Vaericthedev";
const REPO_NAME = "my-config-site2";
const FOLDER_NAME = "Roblox"; 
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Vixix Configs</title>
    <style>
        /* 1. BASE RESET & MAN-MADE TYPOGRAPHY */
        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #0d1117; /* Solid, clean dark background */
            color: #c9d1d9;
            margin: 0;
            padding: 40px 20px;
            line-height: 1.5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
        }

        /* 2. CLEAN LAYOUT */
        .container {
            width: 100%;
            max-width: 900px;
        }

        /* 3. HEADER */
        .header {
            margin-bottom: 32px;
            border-bottom: 1px solid #30363d;
            padding-bottom: 16px;
        }
        .header h1 { 
            margin: 0 0 8px 0; 
            font-size: 24px; 
            font-weight: 600;
            color: #f0f6fc; 
        }
        .header p { 
            margin: 0; 
            color: #8b949e; 
            font-size: 14px; 
        }

        /* 4. SEARCH AND SORT */
        .controls { 
            display: flex; 
            gap: 12px; 
            margin-bottom: 24px; 
        }
        
        input, select {
            flex: 1;
            padding: 10px 14px;
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 6px;
            color: #c9d1d9;
            font-family: inherit;
            font-size: 14px;
            outline: none;
            transition: border-color 0.2s ease;
        }

        input:focus, select:focus {
            border-color: #58a6ff; 
        }

        /* 5. CONFIG GRID */
        .config-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 16px;
        }

        /* 6. CLEAN CARDS */
        .config-card {
            background-color: #161b22;
            border: 1px solid #30363d;
            border-radius: 8px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            transition: border-color 0.2s ease;
            align-items: flex-start; 
        }

        .config-card:hover {
            border-color: #8b949e; 
        }

        .config-card h3 { 
            margin: 0; 
            word-break: break-all; 
            font-size: 14px;
            font-weight: 500;
            color: #f0f6fc;
        }

        /* ========================================= */
        /* 7. THE CLEAN TRANSPARENT BUTTON           */
        /* ========================================= */
        .download-btn {
            /* Layout: Horizontal and compact */
            display: inline-flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 6px;
            
            /* Sizing: Only as big as it needs to be */
            width: auto;
            padding: 6px 12px;
            margin: 0;

            /* Completely transparent, just a subtle border */
            background: transparent;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 6px;
            color: #c9d1d9;
            
            /* Clean typography */
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            
            /* Interaction */
            cursor: pointer;
            outline: none;
            transition: all 0.2s ease;
        }

        /* Hover: Subtle and classy highlight */
        .download-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.3);
            color: #ffffff;
        }

        /* Click: Tactile press */
        .download-btn:active {
            transform: scale(0.97);
        }

        /* Force the SVG to be tiny, clean, and unbroken */
        .download-btn svg {
            width: 14px !important;
            height: 14px !important;
            min-width: 14px !important;
            max-width: 14px !important;
            min-height: 14px !important;
            max-height: 14px !important;
            flex-shrink: 0 !important;
            display: block !important;
            stroke: currentColor !important;
            stroke-width: 2 !important;
            fill: none !important;
            transition: transform 0.2s ease;
        }

        .download-btn:hover svg {
            transform: translateY(1px);
        }

        #loading { 
            color: #8b949e; 
            font-size: 14px;
            text-align: center;
            padding: 20px;
        }
    </style>
</head>
<body>
    
    <div class="container">
        <div class="header">
            <h1>Roblox Configs</h1>
            <p>Download the latest premium configs below.</p>
        </div>

        <div class="controls">
            <input type="text" id="searchBar" placeholder="Search configs..." oninput="filterConfigs()" />
            <select id="sortSelect" onchange="sortConfigs()">
                <option value="name-asc">Sort by Name (A-Z)</option>
                <option value="name-desc">Sort by Name (Z-A)</option>
            </select>
        </div>

        <p id="loading">Loading configs from GitHub... ⏳</p>
        <div class="config-grid" id="configGrid"></div>
    </div>

    <script>
        const API_URL = `https://api.github.com/repos/Vaericthedev/my-config-site2/contents/Roblox`;
        let allConfigs = [];

        async function fetchConfigs() {
            try {
                const response = await fetch(API_URL);
                const data = await response.json();
                
                allConfigs = data.filter(file => {
                    const name = file.name.toLowerCase();
                    return name.endsWith('.json') || name.endsWith('.cfg') || name.endsWith('.txt');
                });

                document.getElementById('loading').style.display = 'none';
                renderConfigs(allConfigs);
            } catch (error) {
                document.getElementById('loading').innerText = "Error loading configs. Make sure the folder exists on GitHub!";
            }
        }

        function renderConfigs(configs) {
            const grid = document.getElementById('configGrid');
            grid.innerHTML = '';

            if (configs.length === 0) {
                grid.innerHTML = '<p style="color: #8b949e; grid-column: 1/-1;">No configs found.</p>';
                return;
            }

            configs.forEach(file => {
                const card = document.createElement('div');
                card.className = 'config-card';

                const title = document.createElement('h3');
                title.textContent = file.name;

                const btn = document.createElement('button');
                btn.className = 'download-btn';
                
                // CLEAN SVG ICON + TEXT
                btn.innerHTML = `
                    <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                    <span>Download</span>
                `;
                
                btn.addEventListener('click', () => {
                    forceDownload(file.download_url + '?raw=true', file.name);
                });

                card.appendChild(title);
                card.appendChild(btn);
                grid.appendChild(card);
            });
        }

        async function forceDownload(url, filename) {
            try {
                const response = await fetch(url);
                const blob = await response.blob();
                const blobUrl = window.URL.createObjectURL(blob);
                
                const a = document.createElement('a');
                a.style.display = 'none';
                a.href = blobUrl;
                a.download = filename;
                document.body.appendChild(a);
                a.click();
                
                window.URL.revokeObjectURL(blobUrl);
                document.body.removeChild(a);
            } catch (error) {
                console.error('Download failed:', error);
                window.open(url, '_blank');
            }
        }

        function filterConfigs() {
            const query = document.getElementById('searchBar').value.toLowerCase();
            const filtered = allConfigs.filter(file => file.name.toLowerCase().includes(query));
            renderConfigs(filtered);
        }

        function sortConfigs() {
            const sortValue = document.getElementById('sortSelect').value;
            const sorted = [...allConfigs].sort((a, b) => {
                if (sortValue === 'name-asc') return a.name.localeCompare(b.name);
                if (sortValue === 'name-desc') return b.name.localeCompare(a.name);
                return 0;
            });
            renderConfigs(sorted);
        }

        fetchConfigs();
    </script>
</body>
</html>
