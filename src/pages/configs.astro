---
// This runs on the server before the page loads
const GITHUB_USERNAME = "Vaericthedev";
const REPO_NAME = "my-config-site2";
const FOLDER_NAME = "Roblox"; 
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Vixix Configs</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap');

        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
            color: #ffffff;
            min-height: 100vh;
            margin: 0;
            padding: 40px 20px;
            display: flex;
            justify-content: center;
        }

        .glass-container {
            width: 100%;
            max-width: 900px;
            background: rgba(255, 255, 255, 0.03);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.3);
        }

        h1 { 
            color: #ffffff; 
            font-weight: 800;
            text-shadow: 0 0 20px rgba(88, 101, 242, 0.6);
            margin-top: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        p.subtitle {
            color: rgba(255, 255, 255, 0.6);
            margin-bottom: 25px;
        }

        .controls { 
            display: flex; 
            gap: 15px; 
            margin-bottom: 30px; 
            flex-wrap: wrap;
        }
        
        input, select {
            padding: 12px 16px;
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(0, 0, 0, 0.3);
            color: white;
            font-family: 'Inter', sans-serif;
            outline: none;
            transition: all 0.3s ease;
            flex: 1;
            min-width: 200px;
        }

        input:focus, select:focus {
            border-color: rgba(88, 101, 242, 0.8);
            background: rgba(0, 0, 0, 0.5);
            box-shadow: 0 0 15px rgba(88, 101, 242, 0.3);
        }

        .config-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .config-card {
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            padding: 20px;
            border-radius: 20px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: transform 0.3s ease, background 0.3s ease, box-shadow 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .config-card:hover {
            transform: translateY(-4px);
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
            border-color: rgba(255, 255, 255, 0.15);
        }

        .config-card h3 { 
            margin: 0 0 20px 0; 
            word-break: break-all; 
            font-size: 1rem;
            font-weight: 600;
            color: #ffffff;
            letter-spacing: -0.02em;
        }

        /* ========================================= */
        /* FIXED IOS GLASS DOWNLOAD BUTTON            */
        /* ========================================= */
        .download-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            max-height: 42px; /* Prevents it from getting too tall */
            padding: 10px 16px;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            overflow: hidden;
            cursor: pointer;
            box-shadow: 
                0 4px 15px rgba(0, 0, 0, 0.2), 
                inset 0 1px 0 rgba(255, 255, 255, 0.2);
            transition: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
        }

        /* The Water Line Effect */
        .download-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -150%;
            width: 50%;
            height: 100%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.4) 50%, rgba(255,255,255,0) 100%);
            transform: skewX(-25deg);
            transition: all 0.6s ease;
        }

        .download-btn:hover {
            background: rgba(88, 101, 242, 0.3);
            border-color: rgba(88, 101, 242, 0.6);
            box-shadow: 0 0 25px rgba(88, 101, 242, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.4);
            transform: translateY(-2px);
        }

        .download-btn:hover::before {
            left: 150%;
        }

        .download-btn:active {
            transform: scale(0.96) translateY(0);
            box-shadow: 0 0 10px rgba(88, 101, 242, 0.4), inset 0 3px 6px rgba(0, 0, 0, 0.3);
        }

        /* FIXED: Forced small size for the SVG icon */
        .download-btn svg {
            width: 16px; 
            height: 16px;
            flex-shrink: 0; /* Prevents it from stretching */
            transition: transform 0.3s ease;
        }

        .download-btn:hover svg {
            transform: translateY(2px);
        }

        #loading { 
            font-style: italic; 
            color: rgba(255, 255, 255, 0.5); 
            text-align: center;
            padding: 20px;
        }
    </style>
</head>
<body>
    
    <div class="glass-container">
        <h1>🎮 Roblox Configs</h1>
        <p class="subtitle">Download the latest premium configs below.</p>

        <div class="controls">
            <input type="text" id="searchBar" placeholder="🔍 Search configs..." onkeyup="filterConfigs()" />
            <select id="sortSelect" onchange="sortConfigs()">
                <option value="name-asc">Sort by Name (A-Z)</option>
                <option value="name-desc">Sort by Name (Z-A)</option>
            </select>
        </div>

        <p id="loading">Loading configs from GitHub... ⏳</p>
        <div class="config-grid" id="configGrid"></div>
    </div>

    <script>
        const API_URL = `https://api.github.com/repos/Vaericthedev/my-config-site2/contents/Roblox`;
        let allConfigs = [];

        async function fetchConfigs() {
            try {
                const response = await fetch(API_URL);
                const data = await response.json();
                
                allConfigs = data.filter(file => 
                    file.name.endsWith('.json') || 
                    file.name.endsWith('.cfg') || 
                    file.name.endsWith('.txt')
                );

                document.getElementById('loading').style.display = 'none';
                renderConfigs(allConfigs);
            } catch (error) {
                document.getElementById('loading').innerText = "Error loading configs. Make sure the folder exists on GitHub!";
            }
        }

        function renderConfigs(configs) {
            const grid = document.getElementById('configGrid');
            grid.innerHTML = '';

            if (configs.length === 0) {
                grid.innerHTML = '<p style="color: rgba(255,255,255,0.5); grid-column: 1/-1;">No configs found matching your search.</p>';
                return;
            }

            configs.forEach(file => {
                const card = document.createElement('div');
                card.className = 'config-card';
                
                // We changed the link to use our new forceDownload JavaScript function
                card.innerHTML = `
                    <h3>${file.name}</h3>
                    <a href="#" class="download-btn" onclick="forceDownload('${file.download_url}', '${file.name}')">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" y1="15" x2="12" y2="3"></line>
                        </svg>
                        Download
                    </a>
                `;
                grid.appendChild(card);
            });
        }

        // ===============================================
        // NEW FUNCTION: Forces the browser to download
        // ===============================================
        async function forceDownload(url, filename) {
            try {
                // Fetch the file from GitHub
                const response = await fetch(url);
                // Convert it to a Blob (a raw file object)
                const blob = await response.blob();
                // Create a temporary internal URL for the file
                const blobUrl = window.URL.createObjectURL(blob);
                
                // Create a hidden link to trigger the download
                const a = document.createElement('a');
                a.href = blobUrl;
                a.download = filename; // This forces the filename and download action
                document.body.appendChild(a);
                a.click(); // Simulate a click
                document.body.removeChild(a);
                
                // Clean up memory
                window.URL.revokeObjectURL(blobUrl);
            } catch (error) {
                console.error('Download failed:', error);
                // If the script fails (e.g., CORS issue), just open the file in a new tab as a fallback
                window.open(url, '_blank');
            }
        }

        function filterConfigs() {
            const query = document.getElementById('searchBar').value.toLowerCase();
            const filtered = allConfigs.filter(file => file.name.toLowerCase().includes(query));
            renderConfigs(filtered);
        }

        function sortConfigs() {
            const sortValue = document.getElementById('sortSelect').value;
            const sorted = [...allConfigs].sort((a, b) => {
                if (sortValue === 'name-asc') return a.name.localeCompare(b.name);
                if (sortValue === 'name-desc') return b.name.localeCompare(a.name);
                return 0;
            });
            renderConfigs(sorted);
        }

        fetchConfigs();
    </script>
</body>
</html>
