---
// No server logic needed here, just the loading screen.
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Loading Vixix Configs...</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #0d1117; /* Dark background */
            color: #ffffff;
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* Container for the loading text */
        .loader-text {
            font-size: 2.5rem; /* Larger text for the main effect */
            font-weight: 800;
            letter-spacing: 0.1em;
            color: #ffffff;
            /* The main glow effect using text-shadow */
            text-shadow: 
                0 0 10px rgba(88, 101, 242, 0.8),
                0 0 20px rgba(88, 101, 242, 0.6),
                0 0 40px rgba(88, 101, 242, 0.4);
            /* Set the animation for the jumping effect */
            animation: jump 1s ease-in-out infinite;
        }

        /* The 'typing' cursor */
        .cursor {
            display: inline-block;
            width: 3px;
            height: 1em;
            background-color: #5865F2;
            margin-left: 5px;
            box-shadow: 0 0 10px #5865F2;
            animation: blink 1s step-end infinite;
        }

        /* Keyframe for the jumping/glow wave */
        @keyframes jump {
            0%, 100% {
                transform: translateY(0);
                text-shadow: 
                    0 0 10px rgba(88, 101, 242, 0.8),
                    0 0 20px rgba(88, 101, 242, 0.6),
                    0 0 40px rgba(88, 101, 242, 0.4);
            }
            50% {
                transform: translateY(-10px); /* Jump up */
                text-shadow: 
                    0 0 15px rgba(88, 101, 242, 1),
                    0 0 30px rgba(88, 101, 242, 0.8),
                    0 0 60px rgba(88, 101, 242, 0.6);
            }
        }

        /* Keyframe for the blinking cursor */
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
    </style>
</head>
<body>
    
    <div class="loader-text" id="loaderText">
        <span id="textContent"></span><span class="cursor"></span>
    </div>

    <script>
        // The text to type out
        const textToType = "Vixix Configs";
        const textContent = document.getElementById('textContent');
        
        let charIndex = 0;

        function typeWriter() {
            if (charIndex < textToType.length) {
                // Add the next character
                textContent.textContent += textToType.charAt(charIndex);
                charIndex++;
                // Type the next character after 120 milliseconds
                setTimeout(typeWriter, 120);
            } else {
                // Once typing is done, wait a moment and then redirect
                setTimeout(() => {
                    window.location.href = '/configs';
                }, 1500); // 1.5 second pause after typing finishes
            }
        }

        // Start the typing effect when the page loads
        window.onload = typeWriter;
    </script>

</body>
</html>
