---
// No server logic needed here, just the loading screen.
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Loading Vixix Configs...</title>
    <style>
        /* Use Inter - the standard font for modern tech companies */
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500;700;800&display=swap');

        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #0a0f1a; 
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(59, 130, 246, 0.1), transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.08), transparent 50%);
            background-size: 200% 200%;
            animation: bg-pan 20s ease-in-out infinite alternate;
            color: #ffffff;
            margin: 0;
            min-height: 100dvh; 
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            padding: 20px; 
        }

        /* Subtle grid overlay */
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 50px 50px;
            z-index: -1;
            mask-image: radial-gradient(circle at center, transparent 10%, black 80%);
            -webkit-mask-image: radial-gradient(circle at center, transparent 10%, black 80%);
        }

        /* Click to Enter Button */
        #enterBtn {
            font-family: 'Inter', sans-serif;
            font-size: clamp(1rem, 4vw, 1.25rem);
            font-weight: 600;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: clamp(12px, 3vw, 16px) clamp(24px, 6vw, 40px);
            border-radius: 50px;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
            white-space: nowrap;
            letter-spacing: 0.02em;
        }

        #enterBtn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
        }

        /* Container for the loading text */
        .loader-container {
            display: none; 
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
            text-align: center;
        }

        .loader-text {
            font-size: clamp(2.5rem, 8vw, 5rem); 
            font-weight: 800;
            letter-spacing: -0.03em;
            line-height: 1.1;
            
            /* The Premium Shimmer Effect */
            background: linear-gradient(90deg, #ffffff 0%, #3b82f6 50%, #ffffff 100%);
            background-size: 200% auto;
            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
            
            /* Soft, static glow behind the text */
            filter: drop-shadow(0 0 30px rgba(59, 130, 246, 0.3));
            
            /* Smooth, continuous shimmer */
            animation: shine 4s linear infinite;
            word-break: break-word;
        }

        .cursor {
            display: inline-block;
            width: 4px;
            height: 0.9em;
            background-color: #3b82f6; 
            margin-left: 8px;
            border-radius: 2px;
            box-shadow: 0 0 10px rgba(59, 130, 246, 0.8);
            animation: blink 1s step-end infinite;
            vertical-align: middle;
        }

        #muteBtn {
            position: fixed;
            bottom: 24px;
            right: 24px;
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            color: white;
            font-size: 1.25rem;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        #muteBtn:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: rgba(255, 255, 255, 0.2);
        }

        /* Keyframes */
        @keyframes shine {
            to { background-position: 200% center; }
        }

        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        @keyframes bg-pan {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }
    </style>
</head>
<body>
    
    <button id="enterBtn">Enter Vixix</button>

    <div class="loader-container" id="loaderContainer">
        <div class="loader-text" id="loaderText">
            <span id="textContent"></span><span class="cursor"></span>
        </div>
    </div>

    <button id="muteBtn">🔇</button>

    <audio id="introMusic" src="/intro-music.mp3" loop></audio>

    <script>
        const enterBtn = document.getElementById('enterBtn');
        const loaderContainer = document.getElementById('loaderContainer');
        const textContent = document.getElementById('textContent');
        const music = document.getElementById('introMusic');
        const muteBtn = document.getElementById('muteBtn');
        
        let charIndex = 0;
        const textToType = "Vixix Configs";

        music.volume = 0.3; 

        enterBtn.addEventListener('click', () => {
            music.play().catch(error => console.log("Audio play failed:", error));
            enterBtn.style.display = 'none';
            loaderContainer.style.display = 'flex';
            muteBtn.textContent = '🔊'; 
            typeWriter();
        });

        muteBtn.addEventListener('click', () => {
            if (music.paused) {
                music.play();
                muteBtn.textContent = '🔊';
            } else {
                music.pause();
                muteBtn.textContent = '🔇';
            }
        });

        function typeWriter() {
            if (charIndex < textToType.length) {
                textContent.textContent += textToType.charAt(charIndex);
                charIndex++;
                // Slightly faster typing for a more premium feel
                setTimeout(typeWriter, 80);
            } else {
                setTimeout(() => {
                    let fadeOut = setInterval(() => {
                        if (music.volume > 0.05) {
                            music.volume -= 0.05;
                        } else {
                            clearInterval(fadeOut);
                            music.pause();
                        }
                    }, 100);

                    setTimeout(() => {
                        window.location.href = '/configs';
                    }, 1500);
                }, 1500); 
            }
        }
    </script>

</body>
</html>
