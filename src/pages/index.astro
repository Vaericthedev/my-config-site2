---
// No server logic needed here, just the loading screen.
---

<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Loading Vixix Configs...</title>
    <style>
        /* Import Poppins */
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;700;800&display=swap');

        *, *::before, *::after { box-sizing: border-box; }
        
        body {
            font-family: 'Poppins', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #050810; /* Deep, almost black blue */
            
            /* THE COOL BACKGROUND: Animated Mesh Gradient */
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(59, 130, 246, 0.15), transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.1), transparent 50%);
            background-size: 200% 200%;
            animation: bg-pan 15s ease-in-out infinite alternate;

            color: #ffffff;
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        /* THE CLEAN TOUCH: Subtle Grid Overlay */
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background-image: 
                linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
            background-size: 40px 40px;
            z-index: -1;
            /* Fades the grid out towards the center so it doesn't distract from the text */
            mask-image: radial-gradient(circle at center, transparent 20%, black 80%);
            -webkit-mask-image: radial-gradient(circle at center, transparent 20%, black 80%);
        }

        /* Container for the loading text */
        .loader-text {
            font-size: 3rem; 
            font-weight: 800;
            letter-spacing: 0.05em;
            color: #ffffff;
            /* The blue neon glow */
            text-shadow: 
                0 0 10px rgba(59, 130, 246, 0.8),
                0 0 20px rgba(59, 130, 246, 0.6),
                0 0 40px rgba(59, 130, 246, 0.4);
            /* The jumping animation */
            animation: jump 1.2s ease-in-out infinite;
        }

        /* The 'typing' cursor */
        .cursor {
            display: inline-block;
            width: 4px;
            height: 1em;
            background-color: #3b82f6; 
            margin-left: 8px;
            box-shadow: 0 0 15px #3b82f6;
            animation: blink 1s step-end infinite;
        }

        /* Keyframe for the jumping/glow wave */
        @keyframes jump {
            0%, 100% {
                transform: translateY(0);
                text-shadow: 
                    0 0 10px rgba(59, 130, 246, 0.8),
                    0 0 20px rgba(59, 130, 246, 0.6),
                    0 0 40px rgba(59, 130, 246, 0.4);
            }
            50% {
                transform: translateY(-15px); 
                text-shadow: 
                    0 0 20px rgba(59, 130, 246, 1),
                    0 0 40px rgba(59, 130, 246, 0.8),
                    0 0 60px rgba(59, 130, 246, 0.6);
            }
        }

        /* Keyframe for the blinking cursor */
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }

        /* Keyframe for the background pan */
        @keyframes bg-pan {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }
    </style>
</head>
<body>
    
    <div class="loader-text" id="loaderText">
        <span id="textContent"></span><span class="cursor"></span>
    </div>

    <script>
        const textToType = "Vixix Configs";
        const textContent = document.getElementById('textContent');
        
        let charIndex = 0;

        function typeWriter() {
            if (charIndex < textToType.length) {
                textContent.textContent += textToType.charAt(charIndex);
                charIndex++;
                setTimeout(typeWriter, 120);
            } else {
                setTimeout(() => {
                    window.location.href = '/configs';
                }, 1500); 
            }
        }

        window.onload = typeWriter;
    </script>

</body>
</html>
